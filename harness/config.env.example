# VMware Fusion 検証ハーネスの設定。
# このファイルを harness/config.env にコピーして、自分の環境に合わせて書き換える。
# harness/config.env は .gitignore 済み (実パスをリポジトリに入れないため)。

# 検証用 VM の .vmx へのフルパス
VMX="${HOME}/Virtual Machines.localized/Ubuntu 26.04 arm64.vmwarevm/Ubuntu 26.04 arm64.vmx"

# ゲスト内のユーザー名 (docs/vm-setup.md で作ったユーザー)
GUEST_USER="ubuntu"

# 復元元スナップショット名
SNAPSHOT="clean"

# ゲストへの SSH に使う秘密鍵
SSH_KEY="${HOME}/.ssh/id_ed25519"

# ゲスト側でリポジトリを展開するパス
GUEST_REPO_DIR="/home/${GUEST_USER}/distro-setup"

# ゲストの sudo パスワード。
# docs/vm-setup.md の手順どおり NOPASSWD を設定していれば空のままでよい。
GUEST_SUDO_PASSWORD=""
