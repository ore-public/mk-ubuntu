[Unit]
Description=xremap - key remapper
Documentation=https://github.com/xremap/xremap
# GNOME Shell と xremap 用拡張が立ち上がってからでないと
# アプリケーション別のリマップが機能しない
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/xremap/config.yml
# ラッパーは GNOME 拡張が応答するまで待ち、現れなければ起動せずに終わる。
# Restart=always で再試行し続けるので、起動回数の制限は外しておく。
StartLimitIntervalSec=0

[Service]
Type=simple
# graphical-session.target 到達直後はまだ拡張の D-Bus 名が出ていないことがある
ExecStartPre=/usr/bin/sleep 5
# パスにユーザー名をハードコードせず %h (ユーザーのホーム) を渡す。
# ラッパーが config.yml と、あれば個人用の config.local.yml を並べて
# xremap を起動する (--watch=device 付き。これがないと起動後に挿した
# USB / Bluetooth キーボードでリマップが効かない)。
ExecStart=/usr/local/bin/xremap-session %h
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
