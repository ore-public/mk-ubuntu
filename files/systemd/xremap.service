[Unit]
Description=xremap - key remapper
Documentation=https://github.com/xremap/xremap
# GNOME Shell と xremap 用拡張が立ち上がってからでないと
# アプリケーション別のリマップが機能しない
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/xremap/config.yml

[Service]
Type=simple
# graphical-session.target 到達直後はまだ拡張の D-Bus 名が出ていないことがある
ExecStartPre=/usr/bin/sleep 5
# パスにユーザー名をハードコードせず %h (ユーザーのホーム) を使う。
# --watch=device がないと、xremap の起動後に現れた入力デバイスを拾わない。
# ログイン後に挿した USB キーボードや Bluetooth キーボードでリマップが
# 効かなくなるので必ず付ける。
ExecStart=/usr/local/bin/xremap --watch=device %h/.config/xremap/config.yml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
