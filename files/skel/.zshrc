#
# 対話 zsh の設定。/etc/skel から新規ユーザーへ配布される。
# 自分用の設定は末尾の「ユーザー個別設定」以降に書き足すこと。
#

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------

# ユーザーローカルに導入したツール (herdr プラグインなど) を優先する
if [[ -d ${HOME}/.local/bin ]] && [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
  path=(${HOME}/.local/bin $path)
fi

# ---------------------------------------------------------------------------
# 履歴
# ---------------------------------------------------------------------------

HISTFILE=${HOME}/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # 実行時刻も記録する
setopt HIST_IGNORE_ALL_DUPS   # 重複した履歴は古い方を捨てる
setopt HIST_IGNORE_SPACE      # 行頭が空白のコマンドは記録しない
setopt HIST_REDUCE_BLANKS     # 余分な空白を詰めて記録する
setopt SHARE_HISTORY          # 複数シェル間で履歴を共有する

# ---------------------------------------------------------------------------
# zimfw
# ---------------------------------------------------------------------------
# zimfw 本体はシステム共有の 1 か所に置いてある。
# モジュールの実体は /etc/skel から引き継いだ ~/.zim/modules にあり、
# 初回シェル起動時に init.zsh だけがこのユーザー用に生成される
# (ネットワークなしで完結する)。

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
ZIMFW_SCRIPT=/usr/local/share/zimfw/zimfw.zsh

if [[ -r ${ZIMFW_SCRIPT} ]]; then
  # .zimrc が init.zsh より新しければ init.zsh を作り直す
  if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZDOTDIR:-${HOME}}/.zimrc ]]; then
    source ${ZIMFW_SCRIPT} init -q
  fi
  [[ -r ${ZIM_HOME}/init.zsh ]] && source ${ZIM_HOME}/init.zsh
fi

# ---------------------------------------------------------------------------
# エイリアス
# ---------------------------------------------------------------------------

# Ubuntu の bat パッケージは batcat という名前でコマンドを入れる
alias bat="batcat"

# ---------------------------------------------------------------------------
# キーバインド
# ---------------------------------------------------------------------------
# 上下キーで、入力済みの文字列に前方一致する履歴を辿る
# (zsh-history-substring-search モジュールが読み込まれている場合のみ)
if (( ${+widgets[history-substring-search-up]} )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# ---------------------------------------------------------------------------
# ユーザー個別設定
# ---------------------------------------------------------------------------

if [[ -r ${HOME}/.zshrc.local ]]; then
  source ${HOME}/.zshrc.local
fi

# シェル起動直後の $? は 0 にしておく。
# ここが非 0 のままだと、プロンプトの終了コード表示や
# 起動直後に $? を見るスクリプトが誤った値を拾う。
true
