# Ghostty の設定。
#
# ★ このファイルは install.sh を実行するたびに上書きされる。
#    自分の設定は同じディレクトリの config.local に書くこと
#    (そちらは上書きされない)。
#
# 設定キーの一覧: https://ghostty.org/docs/config/reference

# ---------------------------------------------------------------------------
# Mac 風のコピー / ペースト
# ---------------------------------------------------------------------------
# ターミナル内では xremap のグローバルなリマップを効かせない
# (Ctrl+C の中断などが壊れるため)。代わりに Ghostty 自身の keybind で
# Alt+C / Alt+V をコピー / ペーストに割り当てる。
# Ghostty の既定である Ctrl+Shift+C / Ctrl+Shift+V も残る。

keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard

# ---------------------------------------------------------------------------
# 見た目
# ---------------------------------------------------------------------------
# Moralerspace Neon HW は 12-fonts.sh が導入する日本語プログラミングフォント。
# Monaspace (英字) と IBM Plex Sans JP (日本語) の合成で、
# HW は日本語を半角幅で組む版。
# フォントを変えたいときは config.local に font-family を書けばよい。

font-family = "Moralerspace Neon HW"
font-size = 12

# ---------------------------------------------------------------------------
# 個人設定の読み込み
# ---------------------------------------------------------------------------
# 先頭の ? は「ファイルが無くてもエラーにしない」という意味。
# 最後に読むので、ここで指定した値が上の設定より優先される。

config-file = ?config.local
